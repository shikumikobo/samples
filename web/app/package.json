{
  "name": "site-manager",
  "version": "0.1.0",
  "private": true,
  "description": "現場管理アプリの見本（Site Manager）。架空の工務店のデータで、ブラウザの中だけで動く",
  "scripts": {
    "embed": "node scripts/embed-sql.mjs",
    "predev": "node scripts/embed-sql.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/embed-sql.mjs",
    "build": "next build",
    "start": "npx serve out",
    "test": "vitest run",
    "test:db": "node --test \"../db/tests/*.test.mjs\"",
    "typecheck": "node scripts/embed-sql.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
